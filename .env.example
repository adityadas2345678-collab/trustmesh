# TRUSTMESH local configuration. Copied to .env by `npm run setup` (never overwritten).
NODE_ENV=development
WEB_PORT=3000
API_PORT=4000
# 127.0.0.1 = laptop only. For the Wi-Fi ESP32 demo set API_HOST=0.0.0.0 (device endpoints are HMAC-authenticated).
API_HOST=127.0.0.1
# Also expose the web UI on the LAN (phones scanning QR codes). Keep false unless needed.
WEB_LAN=false
# Local EVM (Hardhat node). Bound to loopback only.
RPC_URL=http://127.0.0.1:8545
DB_PATH=data/trustmesh.db
MANIFEST_PATH=data/deployment.json
DEVICES_FILE=.local/devices.json
# Base URL used in QR codes, e.g. http://192.168.1.20:3000 — a phone's "localhost" is the phone.
PUBLIC_BASE_URL=
# Local development signer (public Hardhat test keys). Refused when NODE_ENV=production or chainId != 31337.
DEV_SIGNER=true
DEVICE_POLL_MS=1500
CHALLENGE_TTL_SEC=180
TELEMETRY_CHECKPOINT_SEC=300
