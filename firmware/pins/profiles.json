          "dir": "out",
          "supply": "3.3 V",
          "level": "3.3 V",
          "symbol": "PIN_RFID_RST",
          "circuit": "direct; IRQ not connected"
        },
        {
          "component": "DHT22",
          "signal": "DATA",
          "gpio": 4,
          "dir": "io",
          "supply": "3.3 V",
          "level": "3.3 V",
          "symbol": "PIN_DHT",
          "circuit": "10 kΩ pull-up DATA→3.3 V if the module has none"
