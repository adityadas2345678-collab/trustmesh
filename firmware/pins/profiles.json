          "gpio": 34,
          "dir": "in",
          "supply": "5 V",
          "level": "5 V → 3.3 V",
          "symbol": "PIN_US_ECHO",
          "circuit": "divider ECHO—10 kΩ—GPIO34—20 kΩ—GND (≈3.3 V)"
        },
        {
          "component": "IR obstacle module",
          "signal": "DO (active LOW)",
          "gpio": 35,
          "dir": "in",
          "supply": "3.3 V",
          "level": "3.3 V",
          "symbol": "PIN_IR",
          "circuit": "power module from 3.3 V; if powered from 5 V add 10 k/20 k divider; 100 kΩ pull-UP on DO so a disconnected module reads 'absent' (conservative)"
        },
        {
          "component": "Flame module",
          "signal": "DO (active LOW)",
          "gpio": 39,
          "dir": "in",
          "supply": "3.3 V",
          "level": "3.3 V",
          "symbol": "PIN_FLAME",
          "circuit": "power from 3.3 V; set threshold pot with a safe IR stimulus (TV remote), not a flame; 100 kΩ pull-DOWN on DO so a disconnected module reads 'flame-like' (fail-safe, visible)"
